<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:id="@+id/logo_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/ring"
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_ring" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="serif"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="#FFF6EFDD"
            android:textSize="30sp" />

        <View
            android:id="@+id/line"
            android:layout_width="72dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_gold_line" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.22"
            android:text="@string/splash_tagline"
            android:textAllCaps="true"
            android:textColor="#B3E6CD8B"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.08"
        android:text="@string/about_made_with"
        android:textColor="#66F6EFDD"
        android:textSize="11sp" />
</FrameLayout>
